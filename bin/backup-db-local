#!/bin/zsh
#
# Export every non-system database to its own .sql file in a timestamped
# directory under the current one.

read "MYSQL_USER?Enter MySQL username: "
read -s "MYSQL_PWD?Enter MySQL password: "
echo
# mysql and mysqldump read MYSQL_PWD, which keeps the password out of `ps`.
export MYSQL_PWD

MYSQL_HOST="localhost"

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
EXPORT_DIR="db-archive-$TIMESTAMP"

if ! all_databases=$(mysql -u"$MYSQL_USER" -h"$MYSQL_HOST" -N -e "SHOW DATABASES;" 2>/dev/null); then
    echo "Error: Unable to connect to MySQL. Please check your credentials."
    exit 1
fi

databases=$(echo "$all_databases" | grep -Ev "^(information_schema|performance_schema|mysql|sys)$")

mkdir -p "$EXPORT_DIR"

while IFS= read -r db; do
    if [ -n "$db" ]; then
        echo "Exporting $db"
        mysqldump -u"$MYSQL_USER" -h"$MYSQL_HOST" --databases "$db" > "$EXPORT_DIR/$db.sql"
    fi
done <<< "$databases"

echo "Export completed. Files are stored in $EXPORT_DIR"
