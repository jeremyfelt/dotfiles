# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/dotfiles

# b2 4.4.2 has an issue when these are not exported.
# @see https://github.com/Backblaze/B2_Command_Line_Tool/issues/1119
export LINES; export COLUMNS;

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

export WP_TESTS_DIR=$TMPDIR/wordpress-tests-lib
export WP_CORE_DIR=$TMPDIR/wordpress/

# I would assume /usr/local/bin is default? Strange.
export PATH="$PATH:/usr/local/bin"

# Because Homebrew asked nicely to be first?
export PATH="/opt/homebrew/sbin:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/jeremyfelt/Development/gcloud/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/jeremyfelt/Development/gcloud/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/jeremyfelt/Development/gcloud/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/jeremyfelt/Development/gcloud/google-cloud-sdk/completion.zsh.inc'; fi
export PATH="$HOME/.local/bin:$PATH"

export PATH="$HOME/go/bin:$PATH"
export GH_TOKEN=$(gh auth token)
