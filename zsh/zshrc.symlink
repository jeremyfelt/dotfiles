# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/dotfiles

# b2 4.4.2 has an issue when these are not exported.
# @see https://github.com/Backblaze/B2_Command_Line_Tool/issues/1119
export LINES; export COLUMNS;

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# Drop duplicate PATH entries, whatever order the files below add them in.
typeset -U path

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -Uz compinit
# Rescan fpath at most once a day. -C reuses ~/.zcompdump without the scan.
stale_dump=(~/.zcompdump(N.mh+24))
if [[ ! -f ~/.zcompdump ]] || (( ${#stale_dump} ))
then
  compinit
else
  compinit -C
fi
unset stale_dump

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

export WP_TESTS_DIR=$TMPDIR/wordpress-tests-lib
export WP_CORE_DIR=$TMPDIR/wordpress/

# path_helper adds /usr/local/bin only in login shells.
export PATH="$PATH:/usr/local/bin"
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

# Google Cloud SDK.
gcloud_sdk="$HOME/Development/gcloud/google-cloud-sdk"
[ -f "$gcloud_sdk/path.zsh.inc" ] && . "$gcloud_sdk/path.zsh.inc"
[ -f "$gcloud_sdk/completion.zsh.inc" ] && . "$gcloud_sdk/completion.zsh.inc"
unset gcloud_sdk
